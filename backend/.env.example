# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Upstream
OLLAMA_UPSTREAM=https://ollama.com
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_RETRY_MAX=2
UPSTREAM_RETRY_BASE_MS=250
MAX_BODY_BYTES=1000000

# Auth mode: none | static | jwt
AUTH_MODE=none

# Static auth mode
BACKEND_BEARER_TOKEN=

# JWT auth mode (HS256)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_HS256_SECRET=

# Upstream API key handling
# Preferred for production: set UPSTREAM_API_KEY server-side
UPSTREAM_API_KEY=
# Compatibility fallback: when AUTH_MODE=none, allow Authorization bearer to be treated as upstream key
ALLOW_COMPAT_BEARER_KEY=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_PREFIX=rl
REDIS_URL=

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_MS=15000

# Optional model allowlist (comma-separated exact names)
ALLOWED_MODELS=

# SEER alias model (app expert mode)
SEER_MODEL_ENABLED=1
SEER_ALIAS_NAME=SEER
SEER_UPSTREAM_MODEL=qwen3.5:397b-cloud

# Security / networking
TRUST_PROXY=0
SECURITY_HEADERS=1
CORS_ALLOWED_ORIGINS=

# Admin endpoint auth (falls back to BACKEND_BEARER_TOKEN when unset)
ADMIN_BEARER_TOKEN=
